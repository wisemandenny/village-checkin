# Staging environment variables (Vercel project: village-checkin-staging)
# These mirror .env.example but point at ISOLATED staging services so staging
# never touches production data, live payments, or the real mailing list.
# Set these in the staging Vercel project (Settings -> Environment Variables),
# NOT in the production project. See STAGING.md for the full runbook.

# --- Supabase (separate STAGING project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (TEST mode keys — start with sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
# Webhook signing secret for the STAGING webhook endpoint you create in Stripe
# test mode (points at https://<staging-domain>/api/webhook/stripe).
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Optional: a Stripe TEST-mode Product id for recurring support. If unset, one
# is created on demand in the test account.
STRIPE_SUPPORTER_PRODUCT_ID=

# --- App ---
# The staging deployment's public URL (the *.vercel.app domain Vercel assigns,
# or staging.yourdomain.com if you add one later).
NEXT_PUBLIC_BASE_URL=https://village-checkin-staging.vercel.app
# Use a DIFFERENT admin password than production.
ADMIN_PASSWORD=
# Logical environment name. Keep this as "staging" so the maintenance-mode flag
# stays isolated from local and production.
APP_ENV=staging
# Shared secret for the scheduled check-in reconciler (/api/cron/checkins). Use a
# DIFFERENT value than production. Leave blank to disable the schedule on staging.
CRON_SECRET=

# --- Cloudflare R2 (PRIVATE bucket; villager selfies for "who's here") ---
# Point staging at its own bucket so it never writes to the prod bucket. Images
# are served back through the app's /api/selfie route (no public bucket/domain).
# Leave R2_SELFIE_BUCKET blank to disable selfie capture on staging entirely.
R2_ACCOUNT_ID=
R2_SELFIE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Cloudflare R2 (PRIVATE bucket; community gallery uploads) ---
# Point staging at its own uploads bucket. Leave R2_UPLOADS_BUCKET blank to
# disable the gallery upload feature on staging entirely.
R2_UPLOADS_BUCKET=
UPLOAD_TOKEN_SECRET=

# --- Kit (SEPARATE staging Kit account/keys) ---
# Leave these blank to disable Kit on staging entirely. If you want to exercise
# the Kit flows, fill them from your separate staging Kit account (see STAGING.md).
KIT_API_KEY=
KIT_FORM_ID=
KIT_TAG_WEEKLY_ID=
KIT_TAG_MONTHLY_ID=

# Kit OAuth (only needed to test purchase records on staging). Register the
# redirect URI https://<staging-domain>/api/kit/oauth/callback in the staging
# Kit app.
KIT_OAUTH_CLIENT_ID=
KIT_OAUTH_CLIENT_SECRET=
KIT_OAUTH_SETUP_SECRET=

# --- Unpaid check-in reminders (transactional email via Resend) ---
# Use a separate Resend key and (ideally) a test/sandbox sender so staging never
# emails real villagers. Leave RESEND_API_KEY/EMAIL_FROM blank to disable
# reminder sending on staging. Use a DIFFERENT CRON_SECRET than production; the
# GitHub Actions cron reads it from the STAGING_CRON_SECRET repo secret.
RESEND_API_KEY=
EMAIL_FROM=
PAY_TOKEN_SECRET=
CRON_SECRET=
