NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=
# Logical environment name. Maintenance mode is namespaced by this value so that
# local dev (which shares prod's Supabase project) can't lock down production.
# Use "local" here, "staging" on staging, "production" on prod (the default if
# unset).
APP_ENV=local

# Shared secret for the scheduled check-in reconciler (/api/cron/checkins).
# Set the same value as the CRON_SECRET GitHub Actions secret. If unset, the
# cron route returns 503 and the schedule is never enforced (manual toggle still
# works).
CRON_SECRET=

# Cloudflare R2 (PRIVATE bucket) — stores villager selfies shown on the "who's
# here" board. Images are served back through the app's /api/selfie route, so no
# public bucket or custom domain is needed. If unset, selfie capture is skipped
# (registration works exactly as before).
R2_ACCOUNT_ID=
R2_SELFIE_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Cloudflare R2 (PRIVATE bucket) — community gallery uploads (photos/videos).
# Browser uploads go directly to R2 via presigned PUT URLs; reads use short-lived
# presigned GET URLs. If unset, the /gallery page shows a "not available" notice.
R2_UPLOADS_BUCKET=
# HMAC secret for short-lived upload registration tokens (random string).
UPLOAD_TOKEN_SECRET=

# Kit (mailing list) integration
KIT_API_KEY=
KIT_FORM_ID=
KIT_TAG_WEEKLY_ID=
KIT_TAG_MONTHLY_ID=

# Kit OAuth (only needed for purchase records; the /v4/purchases API rejects API keys)
KIT_OAUTH_CLIENT_ID=
KIT_OAUTH_CLIENT_SECRET=
# Random secret that gates the one-time /api/kit/oauth/start authorization route
KIT_OAUTH_SETUP_SECRET=

# Transactional email via Resend (https://resend.com). Used for both unpaid
# check-in reminders and producer booking notifications. If RESEND_API_KEY is
# unset, emails are logged instead of sent so dev builds still work.
RESEND_API_KEY=
# Verified sender for check-in reminders, e.g. "The Village <hello@takesavillagemusic.com>".
EMAIL_FROM=
# Verified sender for producer booking emails.
BOOKING_FROM_EMAIL=bookings@takesavillage.studio
# HMAC secret for signed pay links embedded in reminder emails (random string).
PAY_TOKEN_SECRET=
# Shared secret the reminder crons must present as `Authorization: Bearer <secret>`
# when calling /api/cron/payment-reminders and /api/cron/booking-reminders.
CRON_SECRET=
