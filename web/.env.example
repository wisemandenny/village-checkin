NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ADMIN_PASSWORD=
# Logical environment name. Maintenance mode is namespaced by this value so that
# local dev (which shares prod's Supabase project) can't lock down production.
# Use "local" here, "staging" on staging, "production" on prod (the default if
# unset).
APP_ENV=local

# Kit (mailing list) integration
KIT_API_KEY=
KIT_FORM_ID=
KIT_TAG_WEEKLY_ID=
KIT_TAG_MONTHLY_ID=

# Kit OAuth (only needed for purchase records; the /v4/purchases API rejects API keys)
KIT_OAUTH_CLIENT_ID=
KIT_OAUTH_CLIENT_SECRET=
# Random secret that gates the one-time /api/kit/oauth/start authorization route
KIT_OAUTH_SETUP_SECRET=
